{
    "id": "./",
    "name": "Tassic — Unified Life OS",
    "short_name": "Tassic",
    "description": "A unified life management OS: goals, music studio, recovery tracking, calisthenics, career roadmaps, faith routines, insights and a multimodal journal.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "portrait-primary",
    "background_color": "#BBD8EC",
    "theme_color": "#BBD8EC",
    "categories": ["productivity", "lifestyle", "health", "education"],
    "launch_handler": {
        "client_mode": ["navigate-existing", "auto"]
    },
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "widgets": [
        {
            "name": "Tassic Today",
            "short_name": "Today",
            "description": "Momentum, what's due, your streak and the single next thing worth doing.",
            "tag": "today",
            "ms_ac_template": "widgets/today-widget-template.json",
            "data": "widgets/today-widget-data.json",
            "type": "application/json",
            "auth": false,
            "update": 1800,
            "icons": [
                { "src": "icons/icon-192.png", "sizes": "192x192" }
            ],
            "screenshots": [
                {
                    "src": "icons/icon-512.png",
                    "sizes": "512x512",
                    "label": "Tassic Today widget"
                }
            ]
        }
    ],
    "shortcuts": [
        {
            "name": "Today",
            "short_name": "Today",
            "description": "Your daily brief and checklists",
            "url": "./?tab=today",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Insights",
            "short_name": "Insights",
            "description": "Momentum, trends and what needs attention",
            "url": "./?tab=insights",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "New Journal Entry",
            "short_name": "Journal",
            "description": "Write or record today's entry",
            "url": "./?tab=journal",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Music Studio",
            "short_name": "Music",
            "description": "Today's shape, mode and key",
            "url": "./?tab=music",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Reminder Settings",
            "short_name": "Settings",
            "description": "Notification rules and delivery diagnostics",
            "url": "./?tab=settings",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        }
    ]
}
