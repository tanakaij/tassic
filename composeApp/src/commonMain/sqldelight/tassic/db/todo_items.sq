CREATE TABLE todo_items (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    priority TEXT NOT NULL DEFAULT 'NORMAL',
    dueEpochDay INTEGER,
    tags TEXT NOT NULL DEFAULT '',
    done INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

insertTodo:
INSERT INTO todo_items(title, notes, priority, dueEpochDay, tags, done, createdAt)
VALUES(?, ?, ?, ?, ?, ?, ?);

updateTodo:
UPDATE todo_items SET title = ?, notes = ?, priority = ?, dueEpochDay = ?, tags = ?, done = ?
WHERE id = ?;

deleteTodoById:
DELETE FROM todo_items WHERE id = ?;

selectAllTodos:
SELECT * FROM todo_items ORDER BY done ASC, dueEpochDay ASC, createdAt DESC;

countTodos:
SELECT COUNT(*) FROM todo_items;
