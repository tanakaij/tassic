CREATE TABLE prayer_points (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    details TEXT NOT NULL DEFAULT '',
    category TEXT NOT NULL DEFAULT 'General',
    answered INTEGER NOT NULL DEFAULT 0,
    answeredAt INTEGER,
    createdAt INTEGER NOT NULL
);

insertPrayerPoint:
INSERT INTO prayer_points(title, details, category, answered, answeredAt, createdAt)
VALUES(?, ?, ?, ?, ?, ?);

updatePrayerPoint:
UPDATE prayer_points SET title = ?, details = ?, category = ?, answered = ?, answeredAt = ?
WHERE id = ?;

deletePrayerPointById:
DELETE FROM prayer_points WHERE id = ?;

selectAllPrayerPoints:
SELECT * FROM prayer_points ORDER BY answered ASC, createdAt DESC;

countPrayerPoints:
SELECT COUNT(*) FROM prayer_points;
