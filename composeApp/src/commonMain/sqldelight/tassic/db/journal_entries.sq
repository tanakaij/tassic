-- Multimodal journal: rich text + mood + optional voice note (audioId -> IndexedDB).
CREATE TABLE journal_entries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL DEFAULT '',
    body TEXT NOT NULL DEFAULT '',
    mood INTEGER NOT NULL DEFAULT 3,
    audioId TEXT,
    tags TEXT NOT NULL DEFAULT '',
    createdAt INTEGER NOT NULL
);

insertJournalEntry:
INSERT INTO journal_entries(title, body, mood, audioId, tags, createdAt)
VALUES(?, ?, ?, ?, ?, ?);

updateJournalEntry:
UPDATE journal_entries SET title = ?, body = ?, mood = ?, audioId = ?, tags = ?
WHERE id = ?;

deleteJournalEntryById:
DELETE FROM journal_entries WHERE id = ?;

selectAllJournalEntries:
SELECT * FROM journal_entries ORDER BY createdAt DESC;

countJournalEntries:
SELECT COUNT(*) FROM journal_entries;
