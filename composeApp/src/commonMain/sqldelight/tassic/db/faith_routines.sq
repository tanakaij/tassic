-- Recurring faith routines with Web Notification triggers.
CREATE TABLE faith_routines (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    cadence TEXT NOT NULL DEFAULT 'Daily',
    dayTag TEXT NOT NULL DEFAULT '',
    reminderHour INTEGER NOT NULL DEFAULT 8,
    reminderOn INTEGER NOT NULL DEFAULT 0,
    lastDoneEpochDay INTEGER,
    timesCompleted INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

insertFaithRoutine:
INSERT INTO faith_routines(title, cadence, dayTag, reminderHour, reminderOn, lastDoneEpochDay, timesCompleted, createdAt)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

updateFaithRoutine:
UPDATE faith_routines SET title = ?, cadence = ?, dayTag = ?, reminderHour = ?, reminderOn = ?, lastDoneEpochDay = ?, timesCompleted = ?
WHERE id = ?;

deleteFaithRoutineById:
DELETE FROM faith_routines WHERE id = ?;

selectAllFaithRoutines:
SELECT * FROM faith_routines ORDER BY id ASC;

countFaithRoutines:
SELECT COUNT(*) FROM faith_routines;
